# Current status and sanitized cleanup evidence are versioned. Historical raw
# captures remain private until individually reviewed for publication.
/audits/*
!/audits/STATUS.md
!/audits/OPEN.md
!/audits/COMPLETED.md
!/audits/2026-10-clean-state/
!/AGENTS.md
!/TODO.md
!/SKILLS/
!/SKILLS/*.md

/misc/
# Live SSHFS mount points
/.remote/
/pi/
/sbc/

# Merged-in local dirs from Projects/patrolbot (kept local, not tracked)
/backups/
/rpi_3d_model/
/merge-backup-from-patrolbot/

