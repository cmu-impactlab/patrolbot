# Absolute path to this repository on the deployment host.
PATROLBOT_ROOT=/home/ubuntu/patrolbot-repo

# Use a unique tag for each deployed revision.
PATROLBOT_IMAGE=patrolbot:jazzy-revision
PATROLBOT_REVISION=git-commit-sha

# Required deployment prerequisite (never guess a GID or default to root).
# Install/verify docker/system-reset first, then obtain the numeric host group:
#   getent group patrolbot-reset | cut -d: -f3
# Reset socket wiring is part of the standard Compose file, with no override.
PATROLBOT_RESET_GID=

# Hardware bridge endpoint used by docker/patrolbot-status.
PATROLBOT_SBC_HOST=10.0.0.1
PATROLBOT_SBC_PORT=7272

# Explicit reset-only maintenance opt-in (requires the existing Unix supervisor).
# Both zero keeps commands/reset read-only; commands=1 retains normal reset support.
WEB_BRIDGE_ENABLE_COMMANDS=0
WEB_BRIDGE_ENABLE_RESET=0
