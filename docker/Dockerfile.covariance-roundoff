ARG PATROLBOT_BASE_IMAGE
FROM ${PATROLBOT_BASE_IMAGE}
COPY ros2_ws/src/patrolbot_bridge/patrolbot_bridge/pose_innovation.py /opt/patrolbot_ws/src/patrolbot_bridge/patrolbot_bridge/pose_innovation.py
COPY ros2_ws/src/patrolbot_bridge/test/test_pose_innovation.py /opt/patrolbot_ws/src/patrolbot_bridge/test/test_pose_innovation.py
RUN cp /opt/patrolbot_ws/src/patrolbot_bridge/patrolbot_bridge/pose_innovation.py /opt/patrolbot_ws/install/patrolbot_bridge/lib/python3.12/site-packages/patrolbot_bridge/pose_innovation.py
ARG PATROLBOT_SOURCE_SHA256
RUN actual=$(bash /usr/local/bin/patrolbot-source-tree-digest /opt/patrolbot_ws) && test "$actual" = "$PATROLBOT_SOURCE_SHA256" && printf '%s\n' "$actual" > /opt/patrolbot_ws/PATROLBOT_SOURCE_SHA256
LABEL io.patrolbot.source-tree-sha256=$PATROLBOT_SOURCE_SHA256 io.patrolbot.source-sha256=$PATROLBOT_SOURCE_SHA256
