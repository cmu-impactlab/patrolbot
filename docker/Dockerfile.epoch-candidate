# Development overlay: compile the epoch candidate without touching live services.
# The base already contains reviewed Nav2 patches 0001 and 0002.
ARG PATROLBOT_BASE_IMAGE=patrolbot:issue60-nav2-candidate-20260918
FROM ${PATROLBOT_BASE_IMAGE}
# COPY merges directories; remove inherited sources so deleted/untracked files
# from an older image cannot silently survive the source-integrity check.
RUN rm -rf /opt/patrolbot_ws/src /opt/patrolbot_ws/hardware/patrolbot_hw_server
COPY ros2_ws/src /opt/patrolbot_ws/src
COPY hardware/patrolbot_hw_server /opt/patrolbot_ws/hardware/patrolbot_hw_server
COPY docker/source-tree-digest.sh /opt/patrolbot_ws/source-tree-digest.sh
COPY docker/nav2-patches/0003-amcl-seed-acceptance.patch /tmp/epoch-amcl.patch
COPY docker/nav2-patches/0004-behavior-deactivation.patch /tmp/epoch-behavior.patch
COPY docker/nav2-patches/0005-amcl-pending-seed-priority.patch /tmp/epoch-seed-priority.patch
COPY docker/nav2-patches/0006-bt-plugin-lifetime.patch /tmp/epoch-bt-lifetime.patch
COPY docker/nav2-patches/0007-route-plugin-lifetime.patch /tmp/epoch-route-lifetime.patch
COPY docker/nav2-patches/0008-controller-plugin-lifetime.patch /tmp/epoch-controller-lifetime.patch
COPY docker/nav2-patches/0009-amcl-post-seed-scan.patch /tmp/epoch-post-seed-scan.patch
COPY docker/nav2-patches/0010-manager-callback-lifetime.patch /tmp/epoch-manager-callback.patch
COPY docker/nav2-patches/0011-startup-shutdown-order.patch /tmp/epoch-startup-shutdown.patch
COPY docker/nav2-patches/0012-amcl-tf-readiness.patch /tmp/epoch-tf-readiness.patch
COPY docker/nav2-patches/0013-map-consumption.patch /tmp/map-consumption.patch
COPY docker/nav2-patches/0014-navigation-idle.patch /tmp/navigation-idle.patch
COPY docker/nav2-patches/0015-navigation-configure-first.patch /tmp/navigation-configure-first.patch
ADD --checksum=sha256:bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129 https://codeload.github.com/ros-navigation/navigation2/tar.gz/refs/tags/1.3.12 /tmp/epoch-nav2.tar.gz
ARG PATROLBOT_SOURCE_SHA256
RUN test -n "${PATROLBOT_SOURCE_SHA256}" && \
    test "$(bash /opt/patrolbot_ws/source-tree-digest.sh /opt/patrolbot_ws)" = "${PATROLBOT_SOURCE_SHA256}"
WORKDIR /opt/patrolbot_ws
# Rebuilt packages must not retain installed scripts from the previous source.
RUN for package in patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_docking_plugins patrolbot_navigation; do \
      rm -rf "build/$package" "install/$package"; \
    done && \
    . /opt/patrolbot_ws/install/setup.sh && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
      --packages-select patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_docking_plugins patrolbot_navigation \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
WORKDIR /opt/patrolbot_nav2
RUN tar xzf /tmp/epoch-nav2.tar.gz -C src --strip-components=1 navigation2-1.3.12/nav2_behaviors navigation2-1.3.12/nav2_bt_navigator navigation2-1.3.12/nav2_route navigation2-1.3.12/nav2_regulated_pure_pursuit_controller navigation2-1.3.12/nav2_lifecycle_manager && \
    patch --batch -d src -p1 < /tmp/epoch-behavior.patch && \
    patch --batch -d src -p1 < /tmp/epoch-amcl.patch && \
    patch --batch -d src -p1 < /tmp/epoch-seed-priority.patch && \
    patch --batch -d src -p1 < /tmp/epoch-bt-lifetime.patch && \
    patch --batch -d src -p1 < /tmp/epoch-route-lifetime.patch && \
    patch --batch -d src -p1 < /tmp/epoch-controller-lifetime.patch && \
    patch --batch -d src -p1 < /tmp/epoch-post-seed-scan.patch && \
    patch --batch -d src -p1 < /tmp/epoch-manager-callback.patch && \
    patch --batch -d src -p1 < /tmp/epoch-startup-shutdown.patch && \
    patch --batch -d src -p1 < /tmp/epoch-tf-readiness.patch && \
    patch --batch -d src -p1 < /tmp/map-consumption.patch && \
    patch --batch -d src -p1 < /tmp/navigation-idle.patch && \
    patch --batch -d src -p1 < /tmp/navigation-configure-first.patch && \
    . /opt/patrolbot_ws/install/setup.sh && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
      --packages-select nav2_costmap_2d nav2_amcl nav2_behaviors nav2_bt_navigator nav2_route nav2_regulated_pure_pursuit_controller nav2_lifecycle_manager \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
# Replace inherited metadata with the complete reviewed native patch manifest.
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
ARG PATROLBOT_NAV2_PATCH_SHA256
RUN test -n "${PATROLBOT_NAV2_PATCH_SHA256}" && \
    test "$(for patch_file in /opt/patrolbot-nav2-patches/*.patch; do \
      printf '%s\0' "${patch_file##*/}"; cat "$patch_file"; \
    done | sha256sum | cut -d' ' -f1)" = "${PATROLBOT_NAV2_PATCH_SHA256}"
ARG PATROLBOT_REVISION=unknown
LABEL io.patrolbot.nav2-patch-sha256=${PATROLBOT_NAV2_PATCH_SHA256} \
      io.patrolbot.source-tree-sha256=${PATROLBOT_SOURCE_SHA256} \
      io.patrolbot.source-sha256=${PATROLBOT_SOURCE_SHA256} \
      org.opencontainers.image.revision=${PATROLBOT_REVISION}
WORKDIR /opt/patrolbot_ws
