# Isolated validation image built from canonical source, never a live deployment.
FROM ros:jazzy-ros-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions python3-pytest python3-pytest-asyncio \
    ros-jazzy-navigation2 ros-jazzy-nav2-bringup ros-jazzy-twist-mux \
    ros-jazzy-joy ros-jazzy-teleop-twist-joy build-essential patch \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/patrolbot_nav2
ADD --checksum=sha256:bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129 https://codeload.github.com/ros-navigation/navigation2/tar.gz/refs/tags/1.3.12 /tmp/nav2.tar.gz
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
RUN mkdir src && tar xzf /tmp/nav2.tar.gz -C src --strip-components=1 && \
    for patch_file in /opt/patrolbot-nav2-patches/*.patch; do patch --batch -d src -p1 < "$patch_file" || exit 1; done
RUN . /opt/ros/jazzy/setup.sh && MAKEFLAGS=-j2 colcon build --parallel-workers 2 \
    --packages-up-to nav2_costmap_2d nav2_amcl nav2_map_server nav2_planner nav2_controller nav2_smoother nav2_velocity_smoother nav2_collision_monitor nav2_behaviors nav2_bt_navigator nav2_route nav2_regulated_pure_pursuit_controller nav2_lifecycle_manager nav2_navfn_planner nav2_waypoint_follower opennav_docking \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
WORKDIR /opt/patrolbot_ws
COPY ros2_ws/src src
COPY hardware/patrolbot_hw_server hardware/patrolbot_hw_server
RUN . /opt/patrolbot_nav2/install/setup.sh && colcon build --parallel-workers 2 \
    --packages-select patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_docking_plugins patrolbot_navigation \
    --cmake-args -DBUILD_TESTING=OFF
RUN mkdir -p /var/lib/patrolbot
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

COPY docker/nav2-patches /opt/patrolbot-nav2-patches
COPY docker/source-tree-digest.sh /opt/patrolbot-source-tree-digest.sh
RUN bash /opt/patrolbot-source-tree-digest.sh /opt/patrolbot_ws > /opt/patrolbot-source.sha256 && \
    (for patch_file in /opt/patrolbot-nav2-patches/*.patch; do \
      printf '%s\0' "${patch_file##*/}"; cat "$patch_file"; \
    done) | sha256sum > /opt/patrolbot-nav2-patches.sha256
LABEL io.patrolbot.validation-only="true"
