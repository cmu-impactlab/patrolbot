# Add current-action path telemetry to the exact reviewed deployment image.
ARG PATROLBOT_BASE_IMAGE
FROM ${PATROLBOT_BASE_IMAGE}
USER root
WORKDIR /opt/patrolbot_ws
RUN rm -rf src hardware/patrolbot_hw_server
COPY ros2_ws/src src
COPY hardware/patrolbot_hw_server hardware/patrolbot_hw_server
COPY docker/source-tree-digest.sh /usr/local/bin/patrolbot-source-tree-digest
RUN rm -rf build/patrolbot_interfaces install/patrolbot_interfaces && \
    . install/setup.sh && MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select patrolbot_interfaces \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
COPY docker/nav2-patches/0017-navigation-path-goal-identity.patch /tmp/navigation-path.patch
RUN if [ ! -d /opt/patrolbot_nav2/src/nav2_behavior_tree ]; then \
      test "$(sha256sum /tmp/epoch-nav2.tar.gz | cut -d' ' -f1)" = bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129 && \
      tar xzf /tmp/epoch-nav2.tar.gz -C /opt/patrolbot_nav2/src --strip-components=1 \
        navigation2-1.3.12/nav2_behavior_tree; \
    fi && patch --batch -d /opt/patrolbot_nav2/src -p1 < /tmp/navigation-path.patch
WORKDIR /opt/patrolbot_nav2
RUN . /opt/patrolbot_ws/install/setup.sh && . install/setup.sh && \
    cmake -S src/nav2_behavior_tree -B /tmp/path-bt-build \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DCMAKE_SKIP_BUILD_RPATH=ON && \
    cmake --build /tmp/path-bt-build -j2 --target \
      nav2_compute_path_to_pose_action_bt_node nav2_compute_path_through_poses_action_bt_node && \
    cp /tmp/path-bt-build/libnav2_compute_path_to_pose_action_bt_node.so \
       /tmp/path-bt-build/libnav2_compute_path_through_poses_action_bt_node.so \
       install/nav2_bt_navigator/lib/
# nav2_core exports underlay includes; choose the patched BT headers first.
RUN . /opt/patrolbot_ws/install/setup.sh && . install/setup.sh && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select nav2_bt_navigator --cmake-force-configure \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DCMAKE_CXX_FLAGS=-I/opt/patrolbot_nav2/src/nav2_behavior_tree/include
WORKDIR /opt/patrolbot_ws
ARG PATROLBOT_SOURCE_SHA256
RUN actual=$(/usr/local/bin/patrolbot-source-tree-digest /opt/patrolbot_ws) && \
    test "$actual" = "$PATROLBOT_SOURCE_SHA256" && printf '%s\n' "$actual" > PATROLBOT_SOURCE_SHA256
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
ARG PATROLBOT_NAV2_PATCH_SHA256
RUN test "$(for p in /opt/patrolbot-nav2-patches/*.patch; do printf '%s\0' "${p##*/}"; cat "$p"; done | sha256sum | cut -d' ' -f1)" = "$PATROLBOT_NAV2_PATCH_SHA256"
ARG PATROLBOT_REVISION=unknown
LABEL io.patrolbot.source-tree-sha256=$PATROLBOT_SOURCE_SHA256 \
      io.patrolbot.source-sha256=$PATROLBOT_SOURCE_SHA256 \
      io.patrolbot.nav2-patch-sha256=$PATROLBOT_NAV2_PATCH_SHA256 \
      org.opencontainers.image.revision=$PATROLBOT_REVISION
