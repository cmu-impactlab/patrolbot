# Incremental build on a verified image with the complete series through 0017.
# The deployment retains the pinned archive for packages not extracted earlier.
ARG PATROLBOT_BASE_IMAGE
FROM ${PATROLBOT_BASE_IMAGE}
USER root
WORKDIR /opt/patrolbot_ws
RUN rm -rf src hardware/patrolbot_hw_server
COPY ros2_ws/src src
COPY hardware/patrolbot_hw_server hardware/patrolbot_hw_server
COPY docker/source-tree-digest.sh /usr/local/bin/patrolbot-source-tree-digest
RUN rm -rf build/patrolbot_interfaces install/patrolbot_interfaces && \
    . install/setup.sh && nice -n 10 env MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select patrolbot_interfaces \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
COPY docker/nav2-patches /tmp/goal-planning-patches
RUN cmp /opt/patrolbot-nav2-patches/0017-navigation-path-goal-identity.patch \
        /tmp/goal-planning-patches/0017-navigation-path-goal-identity.patch && \
    if [ ! -d /opt/patrolbot_nav2/src/nav2_planner ] || [ ! -d /opt/patrolbot_nav2/src/nav2_navfn_planner ]; then \
      test "$(sha256sum /tmp/epoch-nav2.tar.gz | cut -d' ' -f1)" = bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129 && \
      tar xzf /tmp/epoch-nav2.tar.gz -C /opt/patrolbot_nav2/src --strip-components=1 \
        navigation2-1.3.12/nav2_planner navigation2-1.3.12/nav2_navfn_planner; \
    fi && \
    test -d /opt/patrolbot_nav2/src/nav2_planner && \
    test -d /opt/patrolbot_nav2/src/nav2_navfn_planner && \
    patch --batch -d /opt/patrolbot_nav2/src -p1 \
      < /tmp/goal-planning-patches/0018-stationary-goal-planning.patch
WORKDIR /opt/patrolbot_nav2
RUN . /opt/patrolbot_ws/install/setup.sh && . install/setup.sh && \
    nice -n 10 env MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select nav2_behavior_tree nav2_bt_navigator nav2_planner nav2_navfn_planner \
    --cmake-force-configure --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DCMAKE_CXX_FLAGS=-I/opt/patrolbot_nav2/src/nav2_behavior_tree/include
WORKDIR /opt/patrolbot_ws
RUN for package in patrolbot_bridge patrolbot_dock_manager patrolbot_docking_plugins patrolbot_navigation patrolbot-launch; do \
      rm -rf "build/$package" "install/$package"; \
    done && \
    . /opt/patrolbot_nav2/install/setup.sh && . install/setup.sh && \
    nice -n 10 env MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select patrolbot_bridge patrolbot_dock_manager patrolbot_docking_plugins patrolbot_navigation patrolbot-launch \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
ARG PATROLBOT_SOURCE_SHA256
RUN test -n "$PATROLBOT_SOURCE_SHA256" && \
    test "$(/usr/local/bin/patrolbot-source-tree-digest /opt/patrolbot_ws)" = "$PATROLBOT_SOURCE_SHA256" && \
    printf '%s\n' "$PATROLBOT_SOURCE_SHA256" > PATROLBOT_SOURCE_SHA256
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
ARG PATROLBOT_NAV2_PATCH_SHA256
RUN test -n "$PATROLBOT_NAV2_PATCH_SHA256" && \
    test "$(for p in /opt/patrolbot-nav2-patches/*.patch; do printf '%s\0' "${p##*/}"; cat "$p"; done | sha256sum | cut -d' ' -f1)" = "$PATROLBOT_NAV2_PATCH_SHA256"
ARG PATROLBOT_REVISION=unknown
LABEL io.patrolbot.source-tree-sha256=$PATROLBOT_SOURCE_SHA256 \
      io.patrolbot.source-sha256=$PATROLBOT_SOURCE_SHA256 \
      io.patrolbot.nav2-patch-sha256=$PATROLBOT_NAV2_PATCH_SHA256 \
      org.opencontainers.image.revision=$PATROLBOT_REVISION
