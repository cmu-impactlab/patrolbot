# Incremental candidate on the verified deployed patches 0001-0015.
ARG PATROLBOT_BASE_IMAGE
FROM ${PATROLBOT_BASE_IMAGE}
COPY docker/nav2-patches/0016-amcl-applied-seed-diagnostics.patch /tmp/applied-seed.patch
RUN patch --batch -d /opt/patrolbot_nav2/src -p1 < /tmp/applied-seed.patch
WORKDIR /opt/patrolbot_nav2
RUN . /opt/patrolbot_ws/install/setup.sh && . /opt/patrolbot_nav2/install/setup.sh && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 1 --packages-select nav2_amcl \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
WORKDIR /opt/patrolbot_ws
RUN rm -rf src hardware/patrolbot_hw_server
COPY ros2_ws/src src
COPY hardware/patrolbot_hw_server hardware/patrolbot_hw_server
COPY docker/source-tree-digest.sh /usr/local/bin/patrolbot-source-tree-digest
RUN for package in patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_navigation; do \
      rm -rf "build/$package" "install/$package"; done && \
    . /opt/patrolbot_ws/install/setup.sh && MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
    --packages-select patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_navigation \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
ARG PATROLBOT_SOURCE_SHA256
RUN actual=$(/usr/local/bin/patrolbot-source-tree-digest /opt/patrolbot_ws) && \
    test "$actual" = "$PATROLBOT_SOURCE_SHA256" && printf '%s\n' "$actual" > PATROLBOT_SOURCE_SHA256
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
ARG PATROLBOT_NAV2_PATCH_SHA256
RUN test "$(for p in /opt/patrolbot-nav2-patches/*.patch; do printf '%s\0' "${p##*/}"; cat "$p"; done | sha256sum | cut -d' ' -f1)" = "$PATROLBOT_NAV2_PATCH_SHA256"
LABEL io.patrolbot.source-tree-sha256=$PATROLBOT_SOURCE_SHA256 \
      io.patrolbot.nav2-patch-sha256=$PATROLBOT_NAV2_PATCH_SHA256
RUN printf '%s\n' '#!/bin/bash' 'set -e' 'source /opt/patrolbot_nav2/install/setup.bash' 'source /opt/patrolbot_ws/install/setup.bash' 'exec "$@"' > /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
