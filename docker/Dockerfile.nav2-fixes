# syntax=docker/dockerfile:1
# Scoped overlay: retain deployed dependencies and build only the patched
# Nav2 packages from the exact upstream release used by the base image.
ARG PATROLBOT_BASE_IMAGE=patrolbot:issue60-timing-018fca14-20260918
FROM ${PATROLBOT_BASE_IMAGE}
ARG NAV2_ARCHIVE_SHA256=bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129
ADD --checksum=sha256:bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129 https://codeload.github.com/ros-navigation/navigation2/tar.gz/refs/tags/1.3.12 /tmp/nav2.tar.gz
COPY docker/nav2-patches /opt/patrolbot-nav2-patches
COPY ros2_ws/src/patrolbot_interfaces /opt/patrolbot_ws/src/patrolbot_interfaces
RUN . /opt/ros/jazzy/setup.sh && cd /opt/patrolbot_ws && \
    colcon build --packages-select patrolbot_interfaces
RUN test "$(dpkg-query -W -f='${Version}' ros-jazzy-nav2-amcl | cut -d- -f1)" = 1.3.12 && \
    test "$(dpkg-query -W -f='${Version}' ros-jazzy-nav2-costmap-2d | cut -d- -f1)" = 1.3.12 && \
    rm -rf /opt/patrolbot_nav2/src /opt/patrolbot_nav2/build /opt/patrolbot_nav2/install /opt/patrolbot_nav2/log && \
    mkdir -p /opt/patrolbot_nav2/src && \
    tar xzf /tmp/nav2.tar.gz -C /opt/patrolbot_nav2/src --strip-components=1 \
      navigation2-1.3.12/nav2_core navigation2-1.3.12/nav2_amcl navigation2-1.3.12/nav2_costmap_2d navigation2-1.3.12/nav2_behaviors navigation2-1.3.12/nav2_behavior_tree navigation2-1.3.12/nav2_bt_navigator navigation2-1.3.12/nav2_route navigation2-1.3.12/nav2_regulated_pure_pursuit_controller navigation2-1.3.12/nav2_lifecycle_manager navigation2-1.3.12/nav2_velocity_smoother navigation2-1.3.12/nav2_util navigation2-1.3.12/nav2_controller navigation2-1.3.12/nav2_planner navigation2-1.3.12/nav2_smoother navigation2-1.3.12/nav2_waypoint_follower && \
    cd /opt/patrolbot_nav2/src && \
    for patch_file in /opt/patrolbot-nav2-patches/*.patch; do \
      case "$patch_file" in *0022-*|*0023-*) patch --batch --fuzz=0 -p1 < "$patch_file" ;; \
        *) patch --batch -p1 < "$patch_file" ;; esac || exit 1; done && \
    rm /tmp/nav2.tar.gz
WORKDIR /opt/patrolbot_nav2
RUN . /opt/patrolbot_ws/install/setup.sh && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 1 \
      --packages-select nav2_util nav2_core nav2_amcl nav2_costmap_2d nav2_behaviors nav2_behavior_tree nav2_bt_navigator nav2_route nav2_regulated_pure_pursuit_controller nav2_lifecycle_manager nav2_velocity_smoother nav2_controller nav2_planner nav2_smoother nav2_waypoint_follower \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF
RUN printf '%s\n' '#!/bin/bash' 'set -e' \
      'source /opt/patrolbot_ws/install/setup.bash' \
      'source /opt/patrolbot_nav2/install/setup.bash' \
      'exec "$@"' > /entrypoint.sh && chmod +x /entrypoint.sh
ARG PATROLBOT_NAV2_PATCH_SHA256=unknown
LABEL io.patrolbot.nav2-upstream-sha256=${NAV2_ARCHIVE_SHA256} \
      io.patrolbot.nav2-patch-sha256=${PATROLBOT_NAV2_PATCH_SHA256}
WORKDIR /opt/patrolbot_ws
