# ROS test image for the PatrolBot Pi-side Python stack.
#
# Builds patrolbot_interfaces (rosidl) + patrolbot_bridge +
# patrolbot_dock_manager and runs their pytest suites, including the
# in-process fake-world integration tests. No hardware, no Nav2 nodes,
# no network services, no robot commands.
#
# Hermetic by default: ROS_LOCALHOST_ONLY keeps DDS discovery on loopback
# (see issue #20), and --network=none can be added at run time since the
# suites need no network after the image is built.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.ros-tests -t patrolbot-ros-tests .
# Run (exit code is pytest's):
#   docker run --rm patrolbot-ros-tests
# Run a subset (arguments replace the default test paths):
#   docker run --rm patrolbot-ros-tests \
#     ros2_ws/src/patrolbot_dock_manager/test/test_contracts.py
#
# CI shape (workflow to be added separately): build once, run the default
# suite, fail the job on nonzero exit. No credentials, no devices, no pushes.
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    ROS_LOCALHOST_ONLY=1 \
    PATROLBOT_RUN_INTEGRATION=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-pytest \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/* \
    && (rosdep init || true)

WORKDIR /opt/patrolbot
COPY ros2_ws/src/patrolbot_interfaces ros2_ws/src/patrolbot_interfaces
COPY ros2_ws/src/patrolbot_bridge ros2_ws/src/patrolbot_bridge
COPY ros2_ws/src/patrolbot_dock_manager ros2_ws/src/patrolbot_dock_manager

RUN rosdep update \
    && apt-get update \
    && rosdep install \
        --from-paths \
            ros2_ws/src/patrolbot_interfaces \
            ros2_ws/src/patrolbot_bridge \
            ros2_ws/src/patrolbot_dock_manager \
        --ignore-src -r -y --rosdistro jazzy \
    && rm -rf /var/lib/apt/lists/*

RUN . /opt/ros/jazzy/setup.sh \
    && colcon build \
        --base-paths ros2_ws/src \
        --packages-select patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager

# Map data and helper scripts for the catalog/persistence suites. Not built:
# nothing imports this package, tests read its files directly.
COPY ros2_ws/src/patrolbot_navigation ros2_ws/src/patrolbot_navigation

COPY docker/run-ros-tests.sh /usr/local/bin/run-ros-tests.sh

ENTRYPOINT ["/usr/local/bin/run-ros-tests.sh"]
