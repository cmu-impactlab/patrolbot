# ROS test image for the PatrolBot Pi-side Python stack.
#
# Builds the interfaces, bridge, dock manager and navigation share data.
# Runs fake-peer integration tests and offline navigation policy tests.
# No hardware, real Nav2 stack, external services or robot commands.
#
# Hermetic by default: ROS_LOCALHOST_ONLY keeps DDS discovery on loopback
# (see issue #20), and --network=none can be added at run time since the
# suites need no network after the image is built.
#
# Build from the repository root:
#   docker build -f docker/Dockerfile.ros-tests -t patrolbot-ros-tests .
# Run (exit code is pytest's):
#   docker run --rm patrolbot-ros-tests
# Run a subset (arguments replace the default test paths):
#   docker run --rm patrolbot-ros-tests \
#     ros2_ws/src/patrolbot_dock_manager/test/test_contracts.py
#
# Build just the reusable toolchain with --target ros-test-env. Source
# changes invalidate only the second stage, not apt/rosdep installation.
# CI can build the final stage and fail on a nonzero container exit.
FROM ros:jazzy-ros-base AS ros-test-env

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    ROS_LOCALHOST_ONLY=1 \
    PATROLBOT_RUN_INTEGRATION=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-pytest \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/* \
    && (rosdep init || true)

WORKDIR /tmp/ros-test-deps
COPY ros2_ws/src/patrolbot_interfaces/package.xml patrolbot_interfaces/package.xml
COPY ros2_ws/src/patrolbot_bridge/package.xml patrolbot_bridge/package.xml
COPY ros2_ws/src/patrolbot_dock_manager/package.xml patrolbot_dock_manager/package.xml

RUN rosdep update \
    && apt-get update \
    && rosdep install \
        --from-paths . \
        --ignore-src -r -y --rosdistro jazzy \
    && rm -rf /var/lib/apt/lists/*

FROM ros-test-env AS ros-tests
WORKDIR /opt/patrolbot
COPY ros2_ws/src/patrolbot_interfaces ros2_ws/src/patrolbot_interfaces
COPY ros2_ws/src/patrolbot_bridge ros2_ws/src/patrolbot_bridge
COPY ros2_ws/src/patrolbot_dock_manager ros2_ws/src/patrolbot_dock_manager
COPY ros2_ws/src/patrolbot_navigation ros2_ws/src/patrolbot_navigation

RUN . /opt/ros/jazzy/setup.sh \
    && colcon build \
        --base-paths ros2_ws/src \
        --packages-select patrolbot_interfaces patrolbot_bridge patrolbot_dock_manager patrolbot_navigation

# Static-contract fixtures only: these packages are not built or launched.
COPY contracts contracts
COPY ros2_ws/src/patrolbot-launch ros2_ws/src/patrolbot-launch
COPY ros2_ws/src/patrolbot_docking_plugins ros2_ws/src/patrolbot_docking_plugins
COPY hardware/patrolbot_hw_server hardware/patrolbot_hw_server
COPY docker/Dockerfile docker/docker-compose.yml docker/status.sh \
     docker/source-tree-digest.sh docker/capture-nav-goal.sh docker/

COPY docker/run-ros-tests.sh /usr/local/bin/run-ros-tests.sh

ENTRYPOINT ["/usr/local/bin/run-ros-tests.sh"]
