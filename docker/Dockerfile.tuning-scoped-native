# syntax=docker/dockerfile:1
# Disposable LOCAL native fixture only. No deployment entrypoint/config changes.
# Supply --build-context nav2_source=/tmp/opencode/save-apply-native-source
# and build/run with --network none. The local archive is checksum-verified here.
ARG PATROLBOT_BASE_IMAGE=patrolbot-tuning-base:441470f84264595217dcc839ac59934975dc030c2e8c3831683638c8d3d43ca6
FROM ${PATROLBOT_BASE_IMAGE}
SHELL ["/bin/bash", "-c"]
COPY --from=nav2_source nav2-1.3.12.tar.gz /tmp/nav2-1.3.12.tar.gz
COPY docker/nav2-patches /opt/scoped-patches
COPY ros2_ws/src/patrolbot_interfaces /opt/scoped-native/src/patrolbot_interfaces
RUN echo 'bcdf575c86250d63007595c992b9c5785c3ec907e897b79abfb4fc7eacbd1129  /tmp/nav2-1.3.12.tar.gz' | sha256sum -c - && \
    mkdir -p /opt/scoped-native/src/nav2 && \
    tar xzf /tmp/nav2-1.3.12.tar.gz -C /opt/scoped-native/src/nav2 --strip-components=1 && \
    cd /opt/scoped-native/src/nav2 && \
    for patch_file in /opt/scoped-patches/*.patch; do \
      case "$patch_file" in *0022-*|*0023-*) patch --batch --fuzz=0 -p1 < "$patch_file" ;; \
        *) patch --batch -p1 < "$patch_file" ;; esac || exit 1; done
WORKDIR /opt/scoped-native
RUN --mount=type=cache,id=patrolbot-scoped-native-build,target=/opt/scoped-native/build \
    --mount=type=cache,id=patrolbot-scoped-native-install,target=/opt/scoped-native/install \
    source /opt/ros/jazzy/setup.bash && \
    MAKEFLAGS=-j2 colcon build --parallel-workers 2 \
      --packages-up-to patrolbot_interfaces nav2_lifecycle_manager nav2_amcl nav2_behaviors \
        nav2_regulated_pure_pursuit_controller nav2_velocity_smoother nav2_controller \
        nav2_bt_navigator nav2_route nav2_planner nav2_smoother nav2_waypoint_follower \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    cp -a /opt/scoped-native/install /opt/scoped-native/cached_install
RUN mv /opt/scoped-native/cached_install /opt/scoped-native/install
COPY docker/tests/integration_tuning_scoped*.py /opt/scoped-tests/
COPY docker/tests/tuning_scoped_cache_probe.cpp /opt/scoped-tests/
COPY docker/tests/tuning_scoped_muxer_probe.cpp /opt/scoped-tests/
COPY docker/tests/tuning_action_input_probe.cpp /opt/scoped-tests/
COPY docker/tests/tuning_scoped_probe /opt/scoped-tests/tuning_scoped_probe
RUN source /opt/scoped-native/install/setup.bash && \
    cmake -S /opt/scoped-tests/tuning_scoped_probe -B /opt/scoped-tests/probe-build && \
    cmake --build /opt/scoped-tests/probe-build -j2
ENV PATROLBOT_ISOLATED_TEST=1 ROS_DOMAIN_ID=173 ROS_LOCALHOST_ONLY=1
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && source /opt/scoped-native/install/setup.bash && exec \"$@\"", "--"]
CMD ["python3", "/opt/scoped-tests/integration_tuning_scoped_native.py"]
