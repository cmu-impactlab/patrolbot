+
+void
+AmclNode::retryInitialPose()
+{
+  std::lock_guard<std::recursive_mutex> cfl(mutex_);
+  if (!active_ || !initial_pose_pending_) {
+    initial_pose_pending_ = false;
+    if (initial_pose_retry_timer_) {
+      initial_pose_retry_timer_->cancel();
+    }
+    return;
+  }
+  if (std::chrono::steady_clock::now() >= pending_initial_pose_deadline_) {
+    RCLCPP_ERROR(
+      get_logger(),
+      "Rejecting initial pose: odom->base_link was unavailable at its timestamp "
+      "within transform_tolerance.");
+    initial_pose_pending_ = false;
+    if (initial_pose_retry_timer_) {
+      initial_pose_retry_timer_->cancel();
+    }
+    return;
+  }
+  const auto msg = pending_initial_pose_;
+  const auto target_time = pending_initial_pose_target_;
+  // Keep the original deadline across retries. A new request explicitly
+  // cancels this state before starting its own bounded attempt.
+  handleInitialPose(msg, target_time);
+}
+
+void
+AmclNode::cancelInitialPoseRetry()
+{
+  std::lock_guard<std::recursive_mutex> cfl(mutex_);
+  initial_pose_pending_ = false;
+  if (initial_pose_retry_timer_) {
+    initial_pose_retry_timer_->cancel();
+    initial_pose_retry_timer_.reset();
+  }
