+# Executors can retain action-entity weak references after navigator teardown.
+# Their control-block vtables live in these plugin libraries. Keep the code
+# mapped until process exit, even after the plugin loader releases its handle.
+# This retains code mappings, not navigator instances or active action goals.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  target_link_options(nav2_navigate_to_pose_navigator PRIVATE "LINKER:-z,nodelete")
+  target_link_options(nav2_navigate_through_poses PRIVATE "LINKER:-z,nodelete")
+endif()
