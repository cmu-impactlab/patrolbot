 void
 AmclNode::initServices()
 {
+  // Read-only consumer readiness: TF publication/discovery alone cannot prove
+  // this AMCL instance has history covering a subsequent operator pose seed.
+  initial_pose_tf_ready_srv_ = create_service<std_srvs::srv::Trigger>(
+    "~/initial_pose_tf_ready",
+    [this](const std::shared_ptr<std_srvs::srv::Trigger::Request>,
+      std::shared_ptr<std_srvs::srv::Trigger::Response> response)
+    {
+      std::lock_guard<std::recursive_mutex> lock(mutex_);
+      response->success = false;
+      response->message = "AMCL is inactive or odometry TF is unavailable";
+      if (!active_ || !tf_buffer_) {return;}
+      try {
+        const auto transform = tf_buffer_->lookupTransform(
+          odom_frame_id_, base_frame_id_, tf2::TimePointZero);
+        const rclcpp::Time stamp(transform.header.stamp, get_clock()->get_clock_type());
+        const auto age = now() - stamp;
+        response->success = stamp.nanoseconds() > 0 && age.nanoseconds() >= 0 &&
+          age.nanoseconds() <= transform_tolerance_.count();
+        response->message = response->success ? "Timestamped odometry TF received" :
+          "Odometry TF timestamp is zero, future or stale";
+      } catch (const tf2::TransformException & error) {
+        response->message = error.what();
+      }
+    });
+
   global_loc_srv_ = create_service<std_srvs::srv::Empty>(
     "reinitialize_global_localization",
     std::bind(&AmclNode::globalLocalizationCallback, this, _1, _2, _3));
