--- a/nav2_amcl/src/amcl_node.cpp
+++ b/nav2_amcl/src/amcl_node.cpp
@@ -23,6 +23,7 @@
 #include "nav2_amcl/amcl_node.hpp"
 
 #include <algorithm>
+#include <cmath>
 #include <memory>
 #include <string>
 #include <utility>
@@ -665,6 +665,36 @@
   init_pose_received_on_inactive = false;
   initial_pose_is_known_ = true;
   accepted_initial_pose_stamp_ns_ = rclcpp::Time(msg.header.stamp).nanoseconds();
+  // Observe the initialized particles before any sensor weighting.
+  const auto application_stamp_ns = now().nanoseconds();
+  const auto & seeded_set = pf_->sets[pf_->current_set];
+  int within_envelope = 0;
+  for (int i = 0; i < seeded_set.sample_count; ++i) {
+    const auto & pose = seeded_set.samples[i].pose;
+    const double yaw_error = std::atan2(
+      std::sin(pose.v[2] - pf_init_pose_mean.v[2]),
+      std::cos(pose.v[2] - pf_init_pose_mean.v[2]));
+    if (std::hypot(pose.v[0] - pf_init_pose_mean.v[0],
+      pose.v[1] - pf_init_pose_mean.v[1]) <= 0.15 &&
+      std::abs(yaw_error) <= 4.0 * M_PI / 180.0)
+    {
+      ++within_envelope;
+    }
+  }
+  RCLCPP_INFO(
+    get_logger(),
+    "Applied initial pose: {\"request_stamp_ns\":%lld,\"application_stamp_ns\":%lld,"
+    "\"mean\":[%.17g,%.17g,%.17g],"
+    "\"covariance\":[%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g,%.17g],"
+    "\"sample_mean\":[%.17g,%.17g,%.17g],\"sample_count\":%d,\"within_envelope\":%d}",
+    static_cast<long long>(accepted_initial_pose_stamp_ns_),
+    static_cast<long long>(application_stamp_ns),
+    pf_init_pose_mean.v[0], pf_init_pose_mean.v[1], pf_init_pose_mean.v[2],
+    pf_init_pose_cov.m[0][0], pf_init_pose_cov.m[0][1], pf_init_pose_cov.m[0][2],
+    pf_init_pose_cov.m[1][0], pf_init_pose_cov.m[1][1], pf_init_pose_cov.m[1][2],
+    pf_init_pose_cov.m[2][0], pf_init_pose_cov.m[2][1], pf_init_pose_cov.m[2][2],
+    seeded_set.mean.v[0], seeded_set.mean.v[1], seeded_set.mean.v[2],
+    seeded_set.sample_count, within_envelope);
   // Acknowledge the original operator stamp only after TF and pf_init succeed.
   initial_pose_ack_pub_->publish(msg);
 }
