+void
+NavfnPlanner::checkStart(unsigned int mx, unsigned int my)
+{
+  const auto blocked = [this](int x, int y) {
+      if (x <= 0 || y <= 0 || x >= static_cast<int>(costmap_->getSizeInCellsX()) - 1 ||
+        y >= static_cast<int>(costmap_->getSizeInCellsY()) - 1)
+      {
+        return true;  // Navfn sets the boundary cells to obstacles.
+      }
+      const auto cost = costmap_->getCost(x, y);
+      return cost >= COST_OBS_ROS && !(cost == COST_UNKNOWN_ROS && allow_unknown_);
+    };
+  const auto x = static_cast<int>(mx);
+  const auto y = static_cast<int>(my);
+  if (blocked(x, y) && blocked(x - 1, y) && blocked(x + 1, y) &&
+    blocked(x, y - 1) && blocked(x, y + 1))
+  {
+    throw nav2_core::StartOccupied(
+            "Planning start is occupied with all four exits blocked at rounded cell (" +
+            std::to_string(mx) + ", " + std::to_string(my) + ")");
+  }
+}
