--- a/nav2_behavior_tree/plugins/decorator/patrolbot_localization_guard.cpp
+++ b/nav2_behavior_tree/plugins/decorator/patrolbot_localization_guard.cpp
@@ -0,0 +1,375 @@
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <future>
+#include <deque>
+#include <utility>
+#include <memory>
+#include <string>
+#include "behaviortree_cpp/bt_factory.h"
+#include "rclcpp/rclcpp.hpp"
+#include "rclcpp_action/types.hpp"
+#include "nav_msgs/msg/odometry.hpp"
+#include "nav_msgs/msg/path.hpp"
+#include "geometry_msgs/msg/pose_with_covariance_stamped.hpp"
+#include "patrolbot_interfaces/msg/base_state.hpp"
+#include "std_srvs/srv/empty.hpp"
+
+namespace nav2_behavior_tree
+{
+using UUID = rclcpp_action::GoalUUID;
+using Steady = std::chrono::steady_clock;
+
+static bool currentPath(const BT::NodeConfiguration & conf)
+{
+  UUID goal{}, path_goal{};
+  nav_msgs::msg::Path path;
+  return conf.blackboard->get("patrolbot_navigation_goal_id", goal) &&
+         conf.blackboard->get("patrolbot_path_goal_id", path_goal) && goal == path_goal &&
+         conf.blackboard->get("path", path) && !path.poses.empty();
+}
+
+class PatrolbotPathGuard : public BT::DecoratorNode
+{
+public:
+  PatrolbotPathGuard(const std::string & name, const BT::NodeConfiguration & conf)
+  : BT::DecoratorNode(name, conf) {}
+  static BT::PortsList providedPorts() {return {};}
+  BT::NodeStatus tick() override
+  {
+    if (!currentPath(config())) {
+      child_node_->haltNode();
+      return BT::NodeStatus::RUNNING;  // Let the planner finish its contextual clear/retry.
+    }
+    return child_node_->executeTick();
+  }
+};
+
+class PatrolbotMotionRecoveryAllowed : public BT::ConditionNode
+{
+public:
+  PatrolbotMotionRecoveryAllowed(const std::string & name, const BT::NodeConfiguration & conf)
+  : BT::ConditionNode(name, conf) {}
+  static BT::PortsList providedPorts() {return {};}
+  BT::NodeStatus tick() override
+  {
+    uint16_t error = 0;
+    (void)config().blackboard->get("compute_path_error_code", error);
+    if (error == 205 || error == 305 || error == 207 || error == 307) {
+      return BT::NodeStatus::FAILURE;
+    }
+    return currentPath(config()) ? BT::NodeStatus::SUCCESS : BT::NodeStatus::FAILURE;
+  }
+};
+
+class PatrolbotLocalizationGuard : public BT::DecoratorNode
+{
+public:
+  PatrolbotLocalizationGuard(const std::string & name, const BT::NodeConfiguration & conf)
+  : BT::DecoratorNode(name, conf)
+  {
+    node_ = config().blackboard->get<rclcpp::Node::SharedPtr>("node");
+    group_ = node_->create_callback_group(rclcpp::CallbackGroupType::MutuallyExclusive, false);
+    executor_.add_callback_group(group_, node_->get_node_base_interface());
+    rclcpp::SubscriptionOptions options;
+    options.callback_group = group_;
+    base_sub_ = node_->create_subscription<patrolbot_interfaces::msg::BaseState>(
+      "/patrolbot/base_state", 10, [this](patrolbot_interfaces::msg::BaseState::SharedPtr msg) {
+        base_ = *msg; base_received_ = Steady::now();
+      }, options);
+    odom_sub_ = node_->create_subscription<nav_msgs::msg::Odometry>(
+      "/odom", rclcpp::SensorDataQoS(), [this](nav_msgs::msg::Odometry::SharedPtr msg) {
+        const auto now = Steady::now();
+        const auto gap = (rclcpp::Time(msg->header.stamp).nanoseconds() -
+          rclcpp::Time(odom_.header.stamp).nanoseconds()) * 1e-9;
+        if (seconds(now - odom_received_) > 0.5 || gap <= 0 || gap > 0.5) {
+          stationary_since_ = Steady::time_point{};
+        }
+        odom_ = *msg;
+        odom_received_ = now;
+        if (!stationary()) {stationary_since_ = Steady::time_point{};}
+      }, options);
+    pose_sub_ = node_->create_subscription<geometry_msgs::msg::PoseWithCovarianceStamped>(
+      "/amcl_pose", rclcpp::QoS(1).transient_local().reliable(),
+      [this](geometry_msgs::msg::PoseWithCovarianceStamped::SharedPtr msg) {
+        pose_ = *msg;
+        pose_received_ = Steady::now();
+        poses_.emplace_back(pose_, pose_received_);
+        if (poses_.size() > 64) {poses_.pop_front();}
+      }, options);
+    refresh_ = node_->create_client<std_srvs::srv::Empty>(
+      "/request_nomotion_update", rclcpp::ServicesQoS(), group_);
+  }
+  static BT::PortsList providedPorts() {return {};}
+
+  void halt() override
+  {
+    clearRequest();
+    refreshing_ = false;
+    BT::DecoratorNode::halt();
+  }
+
+  BT::NodeStatus tick() override
+  {
+    executor_.spin_some();
+    const auto now = Steady::now();
+    UUID goal{};
+    (void)config().blackboard->get("patrolbot_navigation_goal_id", goal);
+    if (goal != goal_) {
+      child_node_->haltNode();
+      clearRequest();
+      goal_ = goal;
+      initialized_ = refreshing_ = false;
+      entered_ = now;
+      context_ = patrolbot_interfaces::msg::BaseState{};
+      awaiting_acceptance_ = {};
+      planner_detail_.clear();
+    }
+    if (!initialized_) {
+      if (base_received_ == Steady::time_point{} || pose_received_ == Steady::time_point{}) {
+        if (seconds(now - entered_) >= 5.0) {return fail("Localization inputs unavailable");}
+        return BT::NodeStatus::RUNNING;
+      }
+      if (!contextValid()) {return fail("Navigation map, seed, epoch or hardware context invalid");}
+      context_ = base_;
+      initialized_ = true;
+    }
+    if (!contextValid() || !sameContext()) {
+      return fail("Navigation context changed; destination invalidated");
+    }
+    if (poses_.empty()) {return BT::NodeStatus::RUNNING;}
+    pose_ = poses_.back().first;
+    if (!poseValid()) {return fail("AMCL estimate failed existing localization checks");}
+    bool accepted = false;
+    for (auto sample = poses_.rbegin(); sample != poses_.rend(); ++sample) {
+      if (rclcpp::Time(sample->first.header.stamp).nanoseconds() <= base_.localization_pose_stamp_ns) {
+        pose_ = sample->first;
+        pose_received_ = sample->second;
+        accepted = true;
+        break;
+      }
+    }
+    if (!accepted) {
+      if (awaiting_acceptance_ == Steady::time_point{}) {awaiting_acceptance_ = now;}
+      child_node_->haltNode();
+      invalidatePath();
+      if (seconds(now - awaiting_acceptance_) >= 5.0 ||
+        (refreshing_ && seconds(now - refresh_started_) >= 5.0))
+      {
+        return fail("AMCL estimate was not accepted by the localization coordinator", refresh_error_);
+      }
+      return BT::NodeStatus::RUNNING;
+    }
+    awaiting_acceptance_ = {};
+    if (!poseValid()) {return fail("Accepted AMCL estimate failed existing localization checks");}
+
+    uint16_t error = 0;
+    (void)config().blackboard->get("compute_path_error_code", error);
+    if (refreshing_) {
+      if (seconds(now - refresh_started_) >= 5.0) {
+        return fail("Stationary localization refresh timed out after 5 seconds", refresh_error_);
+      }
+      if (!stationary()) {
+        stationary_since_ = {};
+        if (requested_) {return fail("Odometry changed during stationary localization refresh", refresh_error_);}
+        return BT::NodeStatus::RUNNING;
+      }
+      if (stationary_since_ == Steady::time_point{}) {stationary_since_ = now;}
+      if (!requested_ && seconds(now - stationary_since_) >= 0.5) {
+        if (!refresh_->service_is_ready()) {
+          return fail("Stationary localization refresh service unavailable", refresh_error_);
+        }
+        request_stamp_ = rclcpp::Time(pose_.header.stamp).nanoseconds();
+        requested_at_ = now;
+        auto pending = refresh_->async_send_request(std::make_shared<std_srvs::srv::Empty::Request>());
+        pending_request_id_ = pending.request_id;
+        future_ = pending.future.share();
+        requested_ = true;
+      }
+      if (requested_ && future_.valid() &&
+        future_.wait_for(std::chrono::seconds(0)) == std::future_status::ready &&
+        pose_received_ > requested_at_ && rclcpp::Time(pose_.header.stamp).nanoseconds() > request_stamp_ &&
+        poseFresh())
+      {
+        try {future_.get();} catch (const std::exception & ex) {
+          return fail(std::string("Stationary localization refresh failed: ") + ex.what(), refresh_error_);
+        }
+        clearRequest();
+        refreshing_ = false;
+        error = 0;
+        config().blackboard->set("compute_path_error_code", uint16_t{0});
+        status("planning", 0, "Localization refreshed; retrying planning");
+        // The child was halted before the request, so this starts one fresh plan.
+      } else {
+        return BT::NodeStatus::RUNNING;
+      }
+    }
+    if (!poseFresh() || error == 205) {
+      bool spent = false;
+      (void)config().blackboard->get("patrolbot_refresh_spent", spent);
+      if (spent) {
+        return fail(error == 205 ? "Planning start remains blocked after localization refresh" :
+          "Localization became stale after the goal's single refresh", error);
+      }
+      config().blackboard->set("patrolbot_refresh_spent", true);
+      child_node_->haltNode();
+      invalidatePath();
+      refreshing_ = true;
+      requested_ = false;
+      refresh_started_ = now;
+      stationary_since_ = {};
+      refresh_error_ = error;
+      planner_detail_.clear();
+      if (error != 0) {
+        (void)config().blackboard->get("patrolbot_planning_error_message", planner_detail_);
+      }
+      status("refreshing", error, "Refreshing localization while stationary" +
+        (planner_detail_.empty() ? std::string{} : ": " + planner_detail_));
+      return BT::NodeStatus::RUNNING;
+    }
+    const auto result = child_node_->executeTick();
+    if (result == BT::NodeStatus::FAILURE) {
+      (void)config().blackboard->get("compute_path_error_code", error);
+      if (error == 205) {return BT::NodeStatus::RUNNING;}
+    }
+    return result;
+  }
+
+private:
+  static double seconds(Steady::duration value) {return std::chrono::duration<double>(value).count();}
+  bool contextValid() const
+  {
+    return seconds(Steady::now() - base_received_) <= 0.5 &&
+      base_.link_connected && base_.hardware_state_valid && std::isfinite(base_.telemetry_age) &&
+      base_.telemetry_age >= 0 && base_.telemetry_age <= 0.5 && !base_.estop_pressed &&
+      base_.fault_flags == 0 && base_.odom_epoch_valid && !base_.localization_recovery_required &&
+      base_.lidar_state == "READY" && std::isfinite(base_.lidar_scan_age) &&
+      base_.lidar_scan_age >= 0 && base_.lidar_scan_age <= 0.5 &&
+      base_.dock_state_valid && base_.dock_state == "CLEAR_CONFIRMED" &&
+      !base_.map_id.empty() && !base_.map_revision.empty() && base_.map_activated_stamp_ns > 0 &&
+      base_.localization_seed_stamp_ns > 0;
+  }
+  bool sameContext() const
+  {
+    return base_.session_generation == context_.session_generation &&
+      base_.odom_epoch == context_.odom_epoch &&
+      base_.odom_epoch_generation == context_.odom_epoch_generation &&
+      base_.map_id == context_.map_id && base_.map_revision == context_.map_revision &&
+      base_.map_activated_stamp_ns == context_.map_activated_stamp_ns &&
+      base_.localization_seed_stamp_ns == context_.localization_seed_stamp_ns;
+  }
+  bool poseValid() const
+  {
+    const auto & p = pose_.pose.pose;
+    const auto stamp = rclcpp::Time(pose_.header.stamp).nanoseconds();
+    if (pose_.header.frame_id != "map" || stamp <= base_.localization_seed_stamp_ns ||
+      stamp < base_.map_activated_stamp_ns || !std::isfinite(p.position.x) ||
+      !std::isfinite(p.position.y) || !std::isfinite(p.position.z) ||
+      !std::isfinite(p.orientation.x) || !std::isfinite(p.orientation.y) ||
+      !std::isfinite(p.orientation.z) || !std::isfinite(p.orientation.w)) {return false;}
+    const auto & q = p.orientation;
+    if (std::abs(q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w - 1.0) > 1e-3) {
+      return false;
+    }
+    for (const auto variance : pose_.pose.covariance) {
+      if (!std::isfinite(variance)) {return false;}
+    }
+    for (const auto i : {0, 7, 35}) {
+      const auto variance = pose_.pose.covariance[i];
+      if (!std::isfinite(variance) || variance <= 0 || variance > 0.25) {return false;}
+    }
+    const auto & c = pose_.pose.covariance;
+    for (const auto a : {0, 1, 5}) {
+      for (const auto b : {0, 1, 5}) {
+        if (std::abs(c[6*a+b] - c[6*b+a]) >
+          std::max(1e-10, 1e-9 * std::max(std::abs(c[6*a+b]), std::abs(c[6*b+a]))))
+        {
+          return false;
+        }
+      }
+    }
+    const auto a = c[0], b = c[1], d = c[7], e = c[5], f = c[11], g = c[35];
+    if (a*d-b*b < 0 || a*g-e*e < 0 || d*g-f*f < 0 ||
+      a*d*g+2*b*e*f-a*f*f-d*e*e-g*b*b < 0) {return false;}
+    return (node_->now().nanoseconds() - stamp) * 1e-9 >= -0.1;
+  }
+  bool poseFresh() const
+  {
+    return (node_->now().nanoseconds() - rclcpp::Time(pose_.header.stamp).nanoseconds()) * 1e-9 <= 30.0;
+  }
+  bool stationary() const
+  {
+    const auto & t = odom_.twist.twist;
+    const auto & p = odom_.pose.pose;
+    const auto & q = p.orientation;
+    if (odom_.header.frame_id != "odom" || odom_.child_frame_id != "base_link" ||
+      !std::isfinite(p.position.x) || !std::isfinite(p.position.y) || !std::isfinite(p.position.z) ||
+      !std::isfinite(q.x) || !std::isfinite(q.y) || !std::isfinite(q.z) || !std::isfinite(q.w) ||
+      std::abs(q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w - 1.0) > 1e-3) {return false;}
+    const auto age = (node_->now().nanoseconds() - rclcpp::Time(odom_.header.stamp).nanoseconds()) * 1e-9;
+    return seconds(Steady::now() - odom_received_) <= 0.5 && age >= -0.1 && age <= 0.5 &&
+      std::isfinite(t.linear.x) && std::isfinite(t.linear.y) && std::isfinite(t.linear.z) &&
+      std::isfinite(t.angular.x) && std::isfinite(t.angular.y) && std::isfinite(t.angular.z) &&
+      std::hypot(t.linear.x, t.linear.y) <= 0.005 && std::abs(t.angular.z) <= 0.01;
+  }
+  void invalidatePath()
+  {
+    config().blackboard->set("path", nav_msgs::msg::Path{});
+    config().blackboard->set("patrolbot_path_goal_id", UUID{});
+  }
+  void status(const std::string & stage, uint16_t code, const std::string & message)
+  {
+    config().blackboard->set("patrolbot_planning_stage", stage);
+    config().blackboard->set("patrolbot_planning_error_code", code);
+    config().blackboard->set("patrolbot_planning_error_message", message);
+  }
+  BT::NodeStatus fail(const std::string & message, uint16_t code = 0)
+  {
+    if (code == 0) {code = 200;}
+    child_node_->haltNode();
+    invalidatePath();
+    clearRequest();
+    refreshing_ = false;
+    std::string planner_detail;
+    (void)config().blackboard->get("patrolbot_planning_error_message", planner_detail);
+    if (planner_detail.rfind("Refreshing localization while stationary", 0) == 0) {
+      planner_detail = planner_detail_;
+    }
+    const auto detail = planner_detail.empty() || planner_detail == message ? message : message + ": " + planner_detail;
+    status("failed", code, detail);
+    config().blackboard->set("compute_path_error_code", code);
+    return BT::NodeStatus::FAILURE;
+  }
+  void clearRequest()
+  {
+    if (future_.valid()) {refresh_->remove_pending_request(pending_request_id_);}
+    future_ = {};
+  }
+  rclcpp::Node::SharedPtr node_;
+  rclcpp::CallbackGroup::SharedPtr group_;
+  rclcpp::executors::SingleThreadedExecutor executor_;
+  rclcpp::Subscription<patrolbot_interfaces::msg::BaseState>::SharedPtr base_sub_;
+  rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr odom_sub_;
+  rclcpp::Subscription<geometry_msgs::msg::PoseWithCovarianceStamped>::SharedPtr pose_sub_;
+  rclcpp::Client<std_srvs::srv::Empty>::SharedPtr refresh_;
