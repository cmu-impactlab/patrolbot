+std::string LifecycleManager::maintenanceEvidence()
+{
+  std::ostringstream out;
+  out << "{\"schema\":1,\"implementation\":\"nav2-1.3.12-scoped-manager-v1\","
+      << "\"held\":" << (maintenance_job_.empty() ? "false" : "true")
+      << ",\"faulted\":" << (maintenance_fault_ ? "true" : "false")
+      << ",\"all_action_paths_excluded\":false,\"job_id\":" << std::quoted(maintenance_job_)
+      << ",\"digest\":" << std::quoted(maintenance_digest_)
+      << ",\"plan_hash\":" << std::quoted(maintenance_plan_) << ",\"states\":{";
+  bool first = true;
+  for (const auto & entry : node_map_) {
+    if (!entry.second) {throw std::runtime_error("Lifecycle client unavailable");}
+    if (!first) {out << ',';}
+    first = false;
+    out << std::quoted(entry.first) << ':' << static_cast<unsigned int>(entry.second->get_state());
+  }
+  out << "},\"prior_states\":{";
+  first = true;
+  for (const auto & entry : maintenance_prior_states_) {
+    if (!first) {out << ',';}
+    first = false;
+    out << std::quoted(entry.first) << ':' << entry.second;
+  }
+  out << "}}";
+  return out.str();
+}
+
+void LifecycleManager::maintenanceCallback(
+  const std::shared_ptr<patrolbot_interfaces::srv::TuningMaintenance::Request> request,
+  std::shared_ptr<patrolbot_interfaces::srv::TuningMaintenance::Response> response)
+{
+  std::lock_guard<std::recursive_mutex> lock(maintenance_mutex_);
+  response->accepted = false;
+  response->detail = "invalid_request";
+  if (!validToken(request->job_id) || !validToken(request->digest, true) ||
+    !validToken(request->plan_hash, true)) {return;}
+  const bool owner = request->job_id == maintenance_job_ &&
+    request->digest == maintenance_digest_ && request->plan_hash == maintenance_plan_;
+  try {
+    if (request->operation == "acquire") {
+      if (!maintenance_job_.empty()) {
+        response->detail = owner ? "already_owned" : "foreign_owner";
+        response->accepted = owner && !maintenance_fault_;
+      } else if (retired_jobs_.count(request->job_id)) {
+        response->detail = "job_already_released";
+      } else if (retired_jobs_.size() >= 1024) {
+        response->detail = "lease_history_full";
+      } else if (bond_respawn_timer_ || node_map_.size() != node_names_.size()) {
+        response->detail = "lifecycle_busy";
+      } else {
+        // Capture every sibling BEFORE ownership; no transitions or goal cancellation here.
+        std::map<std::string, unsigned int> prior;
+        for (const auto & entry : node_map_) {
+          if (!entry.second) {throw std::runtime_error("Lifecycle client unavailable");}
+          const auto state = entry.second->get_state();
+          if (state != State::PRIMARY_STATE_ACTIVE && state != State::PRIMARY_STATE_INACTIVE &&
+            state != State::PRIMARY_STATE_UNCONFIGURED)
+          {response->detail = "lifecycle_busy"; return;}
+          prior[entry.first] = state;
+        }
+        maintenance_prior_states_ = prior;
+        maintenance_job_ = request->job_id;
+        maintenance_digest_ = request->digest;
+        maintenance_plan_ = request->plan_hash;
+        maintenance_fault_ = false;
+        response->accepted = true;
+        response->detail = "acquired_manager_only";
+      }
+    } else if (request->operation == "inspect") {
+      response->accepted = owner && !maintenance_fault_;
+      response->detail = owner ? (maintenance_fault_ ? "recovery_required" : "owned") : "not_owner";
+    } else if (request->operation == "release") {
+      if (!owner) {
+        response->accepted = maintenance_job_.empty() && request->job_id == released_job_ &&
+          request->digest == released_digest_ && request->plan_hash == released_plan_;
+        response->detail = response->accepted ? "already_released" : "not_owner";
+      } else if (maintenance_fault_) {
+        response->detail = "recovery_required";
+      } else {
+        std::set<unsigned int> states;
+        for (const auto & entry : maintenance_prior_states_) {
+          const auto state = node_map_.at(entry.first)->get_state();
+          // Never activate previously inactive nodes. An active node may remain inactive
+          // when ordinary readiness is unavailable; this is not navigation readiness.
+          if (state != entry.second && !(state == State::PRIMARY_STATE_INACTIVE &&
+            (entry.second == State::PRIMARY_STATE_ACTIVE ||
+            entry.second == State::PRIMARY_STATE_UNCONFIGURED)))
+          {response->detail = "state_not_restored"; return;}
+          states.insert(state);
+        }
+        managed_nodes_state_ = states == std::set<unsigned int>{State::PRIMARY_STATE_ACTIVE} ?
+          NodeState::ACTIVE : states == std::set<unsigned int>{State::PRIMARY_STATE_INACTIVE} ?
+          NodeState::INACTIVE : states == std::set<unsigned int>{State::PRIMARY_STATE_UNCONFIGURED} ?
+          NodeState::UNCONFIGURED : NodeState::UNKNOWN;
+        released_job_ = maintenance_job_;
+        released_digest_ = maintenance_digest_;
+        released_plan_ = maintenance_plan_;
+        retired_jobs_.insert(maintenance_job_);
+        maintenance_job_.clear(); maintenance_digest_.clear(); maintenance_plan_.clear();
+        maintenance_prior_states_.clear();
+        response->accepted = true;
+        response->detail = "released";
+      }
+    }
+    response->evidence_json = maintenanceEvidence();
+  } catch (const std::exception & e) {
+    if (!maintenance_job_.empty()) {maintenance_fault_ = true;}
+    response->accepted = false;
+    response->detail = "state_outcome_unknown";
+    RCLCPP_ERROR(get_logger(), "Maintenance state read failed: %s", e.what());
+  }
+}
+
+void LifecycleManager::transitionCallback(
+  const std::shared_ptr<patrolbot_interfaces::srv::TuningTransition::Request> request,
+  std::shared_ptr<patrolbot_interfaces::srv::TuningTransition::Response> response)
+{
+  std::lock_guard<std::recursive_mutex> lock(maintenance_mutex_);
+  response->accepted = false;
+  response->detail = "not_owner";
+  if (maintenance_job_.empty() || request->job_id != maintenance_job_ ||
+    request->digest != maintenance_digest_ || request->plan_hash != maintenance_plan_) {return;}
+  if (maintenance_fault_) {response->detail = "recovery_required"; return;}
+  static const std::set<std::string> allowed{
+    "teleop_velocity_smoother", "amcl", "controller_server", "velocity_smoother",
+    "behavior_server", "patrolbot_joy_teleop"};
+  auto client = node_map_.find(request->node_name);
+  if (!allowed.count(request->node_name) || client == node_map_.end() || !client->second) {
+    response->detail = "node_not_allowed"; return;
+  }
+  const auto transition = request->transition_id;
+  const auto expected = request->expected_state;
+  const bool valid =
+    (transition == Transition::TRANSITION_CONFIGURE && expected == State::PRIMARY_STATE_UNCONFIGURED) ||
+    (transition == Transition::TRANSITION_CLEANUP && expected == State::PRIMARY_STATE_INACTIVE) ||
+    (transition == Transition::TRANSITION_ACTIVATE && expected == State::PRIMARY_STATE_INACTIVE &&
+    maintenance_prior_states_.at(request->node_name) == State::PRIMARY_STATE_ACTIVE) ||
+    (transition == Transition::TRANSITION_DEACTIVATE && expected == State::PRIMARY_STATE_ACTIVE);
+  if (!valid) {response->detail = "transition_not_allowed"; return;}
+  try {
+    if (client->second->get_state() != expected) {response->detail = "state_conflict"; return;}
+    // The existing manager owns bond bookkeeping and exactly this one transition.
+    if (!changeStateForNode(request->node_name, transition)) {
+      maintenance_fault_ = true;
+      response->detail = "transition_outcome_unknown";
+    } else {
+      response->accepted = true;
+      response->detail = "transitioned";
+    }
+    response->evidence_json = maintenanceEvidence();
+  } catch (const std::exception & e) {
+    maintenance_fault_ = true;
+    response->accepted = false;
+    response->detail = "transition_outcome_unknown";
+    RCLCPP_ERROR(get_logger(), "Maintenance transition failed: %s", e.what());
+  }
+}
