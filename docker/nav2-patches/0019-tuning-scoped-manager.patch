+bool validToken(const std::string & value, bool hash = false)
+{
+  if (value.empty() || value.size() > 128 || (hash && value.size() != 64)) {return false;}
+  return std::all_of(value.begin(), value.end(), [hash](unsigned char c) {
+    return hash ? ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) :
+           ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.');
+  });
+}
+}
