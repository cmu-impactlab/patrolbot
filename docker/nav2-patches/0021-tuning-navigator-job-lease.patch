+          return hash ? ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) :
+                 ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                 (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.');
+        });
+      };
+    if (!valid(job, false) || !valid(digest, true) || !valid(plan, true)) {return false;}
