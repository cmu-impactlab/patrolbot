@@ -0,0 +1,57 @@
+// One input boundary for the fixed, single-process composed Nav2 deployment.
+// The existing BtNavigator maintenance endpoint owns its Boolean closure; this
+// adds no per-node service, lifecycle schedule, expiry, or signing authority.
+#ifndef NAV2_UTIL__TUNING_ACTION_GATE_HPP_
+#define NAV2_UTIL__TUNING_ACTION_GATE_HPP_
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <set>
+#include <utility>
+
+namespace nav2_util
+{
+struct TuningActionGate
+{
+  using GoalId = std::array<uint8_t, 16>;
+  using Key = std::pair<std::uintptr_t, GoalId>;
+  std::mutex mutex;
+  bool held{false};
+  bool core_held{true};
+  bool faulted{false};
+  std::set<Key> goals;
+  std::size_t workers{0};
+
+  bool beginGoal(const void * server, const GoalId & uuid)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return !held && !core_held && !faulted &&
+           goals.emplace(reinterpret_cast<std::uintptr_t>(server), uuid).second;
+  }
+
+  void endGoal(const void * server, const GoalId & uuid)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (goals.erase(Key{reinterpret_cast<std::uintptr_t>(server), uuid}) != 1) {
+      faulted = true;
+    }
+  }
+
+  void beginWork()
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    ++workers;
+  }
+
+  void endWork()
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (workers == 0) {faulted = true;} else {--workers;}
+  }
+};
+
+// Defined in nav2_util_core, NOT a template/static singleton per plugin DSO.
+TuningActionGate & tuningActionGate();
+}  // namespace nav2_util
+#endif  // NAV2_UTIL__TUNING_ACTION_GATE_HPP_
