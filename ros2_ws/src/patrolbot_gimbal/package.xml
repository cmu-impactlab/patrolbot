<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>patrolbot_gimbal</name>
  <version>0.0.0</version>
  <description>
    SimpleBGC 32-bit camera gimbal control for PatrolBot. Deliberately isolated
    from the cmd_vel chain: this package reads /joy and drives a serial gimbal
    controller, and publishes nothing that can affect robot motion.
  </description>
  <maintainer email="ymh1874@gmail.com">Yousef Hussein</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>patrolbot_interfaces</depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
